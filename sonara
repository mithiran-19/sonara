              <SkipBack className="w-5 h-5" />
            </button>
            <button
              onClick={() => setIsPlaying(!isPlaying)}
              className="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center hover:scale-105 transition-all shadow-lg"
            >
              {isPlaying ? <Pause className="w-5 h-5 fill-current" /> : <Play className="w-5 h-5 fill-current ml-0.5" />}
            </button>
            <button onClick={handleNextTrack} className="text-slate-300 hover:text-white transition-all">
              <SkipForward className="w-5 h-5" />
            </button>
            <button
              onClick={() => setRepeatMode(repeatMode === 'off' ? 'all' : repeatMode === 'all' ? 'one' : 'off')}
              className={`text-xs ${repeatMode !== 'off' ? 'text-purple-400' : 'text-slate-500'} hover:text-slate-300 transition-all`}
            >
              <Repeat className="w-4 h-4" />
            </button>
          </div>

          {/* TIMELINE SEEK BAR */}
          <div className="w-full flex items-center space-x-3 text-xs text-slate-400">
            <span>{formatTime(currentTime)}</span>
            <input
              type="range"
              min={0}
              max={duration || 100}
              value={currentTime}
              onChange={(e) => {
                const val = Number(e.target.value);
                setCurrentTime(val);
                if (audioRef.current) audioRef.current.currentTime = val;
              }}
              className="w-full accent-purple-500 h-1 bg-slate-800 rounded-lg cursor-pointer"
            />
            <span>{formatTime(duration)}</span>
          </div>
        </div>

        {/* VOLUME & AUXILIARY CONTROLS */}
        <div className="flex items-center justify-end space-x-4 w-1/4 min-w-[200px]">
          <button
            onClick={() => setShowLyrics(!showLyrics)}
            className={`p-2 rounded-lg text-xs font-semibold border transition-all ${
              showLyrics ? 'bg-purple-600/30 border-purple-500 text-purple-300' : 'bg-slate-900 border-slate-800 text-slate-400'
            }`}
          >
            Lyrics
          </button>
          <div className="flex items-center space-x-2">
            <button onClick={() => setIsMuted(!isMuted)} className="text-slate-400 hover:text-slate-200">
              {isMuted || volume === 0 ? <VolumeX className="w-4 h-4" /> : <Volume2 className="w-4 h-4" />}
            </button>
            <input
              type="range"
              min={0}
              max={1}
              step={0.01}
              value={isMuted ? 0 : volume}
              onChange={(e) => setVolume(Number(e.target.value))}
              className="w-20 accent-purple-500 h-1 bg-slate-800 rounded-lg cursor-pointer"
            />
          </div>
        </div>
      </footer>

      {/* AUDIO ELEMENT */}
      <audio ref={audioRef} src={currentTrack?.audioUrl} crossOrigin="anonymous" preload="auto" />

      {/* FULLSCREEN AMBIENT VISUALIZER OVERLAY */}
      {isFullscreenVisualizer && (
        <div className="fixed inset-0 z-50 bg-[#080810] flex flex-col justify-between p-8 animate-fade-in">
          {/* TOP BAR */}
          <div className="flex items-center justify-between">
            <div className="flex items-center space-x-3">
              <span className="w-3 h-3 rounded-full animate-ping" style={{ background: moodTheme.primary }} />
              <span className="text-xs font-bold uppercase tracking-widest text-slate-300">
                Visualizer Engine: {visualizerStyle} ({effectiveMood})
              </span>
            </div>
            <button
              onClick={() => setIsFullscreenVisualizer(false)}
              className="p-3 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white border border-slate-700 transition-all"
            >
              <X className="w-6 h-6" />
            </button>
          </div>

          {/* CENTER METADATA DISPLAY */}
          <div className="text-center space-y-4 max-w-lg mx-auto z-10">
            <img
              src={currentTrack?.cover}
              alt={currentTrack?.title}
              className="w-48 h-48 rounded-3xl mx-auto shadow-2xl border-2 border-purple-500/30 object-cover"
            />
            <div>
              <h2 className="text-3xl font-extrabold text-white">{currentTrack?.title}</h2>
              <p className="text-purple-400 font-medium text-base mt-1">{currentTrack?.artist}</p>
            </div>
          </div>

          {/* BOTTOM CONTROLS */}
          <div className="flex justify-center items-center space-x-4 max-w-md mx-auto w-full z-10">
            <button onClick={handlePrevTrack} className="p-3 text-slate-300 hover:text-white">
              <SkipBack className="w-6 h-6" />
            </button>
            <button
              onClick={() => setIsPlaying(!isPlaying)}
              className="w-14 h-14 rounded-full bg-white text-black flex items-center justify-center hover:scale-105 transition-all shadow-xl"
            >
              {isPlaying ? <Pause className="w-6 h-6 fill-current" /> : <Play className="w-6 h-6 fill-current ml-1" />}
            </button>
            <button onClick={handleNextTrack} className="p-3 text-slate-300 hover:text-white">
              <SkipForward className="w-6 h-6" />
            </button>
          </div>
        </div>
      )}

      {/* EQUALIZER MODAL */}
      {showEqModal && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-[#0c0c18] border border-slate-800 rounded-3xl p-6 w-full max-w-md space-y-6">
            <div className="flex items-center justify-between border-b border-slate-800 pb-4">
              <h3 className="text-lg font-bold text-white flex items-center space-x-2">
                <Sliders className="w-5 h-5 text-purple-400" />
                <span>5-Band Equalizer</span>
              </h3>
              <button onClick={() => setShowEqModal(false)} className="text-slate-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* PRESETS */}
            <div className="space-y-2">
              <label className="text-xs text-slate-400 font-medium">EQ Preset</label>
              <div className="flex flex-wrap gap-2">
                {['Flat', 'Bass Boost', 'Vocal', 'Electronic', 'Chill'].map((preset) => (
                  <button
                    key={preset}
                    onClick={() => setEqPreset(preset)}
                    className={`text-xs px-3 py-1.5 rounded-lg border transition-all ${
                      eqPreset === preset
                        ? 'bg-purple-600/30 border-purple-500 text-purple-300 font-bold'
                        : 'bg-slate-900 border-slate-800 text-slate-400'
                    }`}
                  >
                    {preset}
                  </button>
                ))}
              </div>
            </div>

            {/* BAND SLIDERS */}
            <div className="grid grid-cols-5 gap-4 py-4">
              {['60Hz', '250Hz', '1kHz', '4kHz', '16kHz'].map((band, idx) => (
                <div key={band} className="flex flex-col items-center space-y-3">
                  <input
                    type="range"
                    min={-12}
                    max={12}
                    value={eqGains[idx]}
                    onChange={(e) => {
                      const newGains = [...eqGains];
                      newGains[idx] = Number(e.target.value);
                      setEqGains(newGains);
                    }}
                    className="accent-purple-500 h-28 -rotate-90 my-8 bg-slate-800 rounded-lg cursor-pointer"
                  />
                  <span className="text-[10px] text-slate-400 font-mono">{band}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* LYRICS OVERLAY SLIDE-OUT */}
      {showLyrics && (
        <div className="fixed right-6 bottom-28 z-40 w-80 max-h-96 bg-[#0c0c1a]/95 border border-purple-500/30 rounded-2xl p-4 shadow-2xl backdrop-blur-xl overflow-y-auto space-y-3 animate-slide-up">
          <div className="flex items-center justify-between border-b border-slate-800 pb-2">
            <h4 className="text-xs font-bold text-purple-400 tracking-wider uppercase">Synchronized Lyrics</h4>
            <button onClick={() => setShowLyrics(false)} className="text-slate-400 hover:text-white">
              <X className="w-4 h-4" />
            </button>
          </div>
          <pre className="text-xs text-slate-300 font-sans leading-relaxed whitespace-pre-wrap">
            {currentTrack?.lyrics || 'No synchronized lyrics available for this track.'}
          </pre>
        </div>
      )}
    </div>
  );
}

// SUBCOMPONENT: TRACK CARD
function TrackCard({ track, onPlay, isPlaying }) {
  return (
    <div className="group bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800/80 hover:border-purple-500/40 rounded-2xl p-3 transition-all duration-300 flex flex-col justify-between backdrop-blur-md">
      <div className="relative aspect-square rounded-xl overflow-hidden mb-3">
        <img src={track.cover} alt={track.title} className="w-full h-full object-cover group-hover:scale-105 transition-all duration-300" />
        <button
          onClick={() => onPlay(track)}
          className="absolute inset-0 m-auto w-12 h-12 rounded-full bg-purple-600/90 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-lg shadow-purple-500/50"
        >
          {isPlaying ? <Pause className="w-5 h-5 fill-current" /> : <Play className="w-5 h-5 fill-current ml-0.5" />}
        </button>
      </div>
      <div>
        <h4 className="font-bold text-sm text-slate-100 truncate group-hover:text-purple-300 transition-all">{track.title}</h4>
        <p className="text-xs text-slate-400 truncate mt-0.5">{track.artist}</p>
      </div>
    </div>
  );
}
