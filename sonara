export default function App() {
  // Navigation & Page State
  const [activeTab, setActiveTab] = useState('home');
  const [searchQuery, setSearchQuery] = useState('');
  
  // Player State
  const [catalog, setCatalog] = useState(INITIAL_CATALOG);
  const [currentTrack, setCurrentTrack] = useState(INITIAL_CATALOG[0]);
  const [isPlaying, setIsPlaying] = useState(false);
  const [currentTime, setCurrentTime] = useState(0);
  const [duration, setDuration] = useState(0);
  const [volume, setVolume] = useState(0.8);
  const [isMuted, setIsMuted] = useState(false);
  const [isShuffle, setIsShuffle] = useState(false);
  const [repeatMode, setRepeatMode] = useState('off'); // 'off', 'all', 'one'
  const [playbackSpeed, setPlaybackSpeed] = useState(1);
  const [queue, setQueue] = useState(INITIAL_CATALOG);
  const [history, setHistory] = useState([]);
  const [favorites, setFavorites] = useState(['track-1', 'track-6']);
  const [localTracks, setLocalTracks] = useState([]);

  // Audio Visualizer & Customization State
  const [visualizerStyle, setVisualizerStyle] = useState('Aurora');
  const [overrideMood, setOverrideMood] = useState(null);
  const [isFullscreenVisualizer, setIsFullscreenVisualizer] = useState(false);
  const [showEqModal, setShowEqModal] = useState(false);
  const [showLyrics, setShowLyrics] = useState(false);
  const [sleepTimer, setSleepTimer] = useState(null); // in minutes
  const [eqPreset, setEqPreset] = useState('Flat');
  const [eqGains, setEqGains] = useState([0, 0, 0, 0, 0]); // 60, 250, 1k, 4k, 16k Hz

  // AI & User Playlists
  const [userPlaylists, setUserPlaylists] = useState([
    {
      id: 'pl-1',
      name: 'Cyberpunk Neon Vibe',
      description: 'Futuristic beats & synthwave pulses',
      cover: 'https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=600&auto=format&fit=crop&q=80',
      trackIds: ['track-1', 'track-4']
    },
    {
      id: 'pl-2',
      name: 'Late Night Chill & Code',
      description: 'Mellow ambient and lo-fi soundscapes',
      cover: 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=600&auto=format&fit=crop&q=80',
      trackIds: ['track-2', 'track-3']
    }
  ]);
  const [aiPrompt, setAiPrompt] = useState('');
  const [isGeneratingAi, setIsGeneratingAi] = useState(false);

  // Audio References & Context
  const audioRef = useRef(null);
  const audioCtxRef = useRef(null);
  const analyserRef = useRef(null);
  const sourceRef = useRef(null);
  const canvasRef = useRef(null);
  const animFrameRef = useRef(null);

  // Derived Values
  const effectiveMood = overrideMood || currentTrack?.mood || 'Cyber/EDM';
  const moodTheme = MOOD_COLORS[effectiveMood] || MOOD_COLORS['Cyber/EDM'];

  // --- AUDIO SETUP & WEB AUDIO API ANALYSIS ---
  useEffect(() => {
    if (!audioRef.current) return;
    const audio = audioRef.current;
    
    // Auto sync duration
    const handleLoadedData = () => {
      setDuration(audio.duration || currentTrack.duration || 0);
    };
    const handleTimeUpdate = () => {
      setCurrentTime(audio.currentTime);
    };
    const handleEnded = () => {
      if (repeatMode === 'one') {
        audio.currentTime = 0;
        audio.play();
      } else {
        handleNextTrack();
      }
    };

    audio.addEventListener('loadeddata', handleLoadedData);
    audio.addEventListener('timeupdate', handleTimeUpdate);
    audio.addEventListener('ended', handleEnded);

    return () => {
      audio.removeEventListener('loadeddata', handleLoadedData);
      audio.removeEventListener('timeupdate', handleTimeUpdate);
      audio.removeEventListener('ended', handleEnded);
    };
  }, [currentTrack, repeatMode, queue]);

  // Handle Play/Pause
  useEffect(() => {
    if (!audioRef.current) return;
    if (isPlaying) {
      // Initialize Web Audio Context on first user playback
      initWebAudio();
      audioRef.current.play().catch(() => {
        // Fallback for browser autoplay policies
        setIsPlaying(false);
      });
    } else {
      audioRef.current.pause();
    }
  }, [isPlaying, currentTrack]);

  // Sync Volume & Speed
  useEffect(() => {
    if (audioRef.current) {
      audioRef.current.volume = isMuted ? 0 : volume;
      audioRef.current.playbackRate = playbackSpeed;
    }
  }, [volume, isMuted, playbackSpeed]);

  // Sleep Timer countdown
  useEffect(() => {
    if (!sleepTimer) return;
    const timer = setTimeout(() => {
      setIsPlaying(false);
      setSleepTimer(null);
    }, sleepTimer * 60 * 1000);
    return () => clearTimeout(timer);
  }, [sleepTimer]);

  // Initialize Web Audio API node tree
  const initWebAudio = () => {
    if (audioCtxRef.current || !audioRef.current) return;
    try {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      const ctx = new AudioCtx();
      const analyser = ctx.createAnalyser();
      analyser.fftSize = 128; // 64 frequency bins
      
      // Connect source safely (CORS safe cross-origin)
      const source = ctx.createMediaElementSource(audioRef.current);
      source.connect(analyser);
      analyser.connect(ctx.destination);

      audioCtxRef.current = ctx;
      analyserRef.current = analyser;
      sourceRef.current = source;
    } catch (err) {
      console.log('Web Audio API initialized in fallback spectrum simulation mode', err);
    }
  };

  // --- AUDIO REACTIVE CANVAS VISUALIZER ---
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    
    // Resize handler
    const resizeCanvas = () => {
      canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;
      canvas.height = canvas.parentElement?.clientHeight || window.innerHeight;
    };
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    let phase = 0;
    const render = () => {
      const width = canvas.width;
      const height = canvas.height;
      ctx.clearRect(0, 0, width, height);

      // Get real audio frequency data or fallback simulation
      const bufferLength = analyserRef.current ? analyserRef.current.frequencyBinCount : 32;
      const dataArray = new Uint8Array(bufferLength);
      if (analyserRef.current && isPlaying) {
        analyserRef.current.getByteFrequencyData(dataArray);
      } else if (isPlaying) {
        // Fallback simulation when Web Audio node is locked or loading
        for (let i = 0; i < bufferLength; i++) {
          dataArray[i] = Math.floor(Math.sin(phase + i * 0.2) * 50 + 120 + Math.random() * 30);
        }
      }

      // Calculate audio metrics
      let bass = 0, mid = 0, treble = 0;
      for (let i = 0; i < bufferLength; i++) {
        if (i < bufferLength * 0.25) bass += dataArray[i];
        else if (i < bufferLength * 0.75) mid += dataArray[i];
        else treble += dataArray[i];
      }
      bass = (bass / (bufferLength * 0.25)) || 10;
      mid = (mid / (bufferLength * 0.5)) || 10;
      treble = (treble / (bufferLength * 0.25)) || 10;
      const energy = (bass * 1.5 + mid + treble) / 3;

      phase += 0.02 + (energy / 2550);

      // Render selected visualizer style
      switch (visualizerStyle) {
        case 'Aurora':
          drawAurora(ctx, width, height, dataArray, moodTheme, phase, energy);
          break;
        case 'Galaxy':
          drawGalaxy(ctx, width, height, dataArray, moodTheme, phase, bass);
          break;
        case 'Neon Pulse':
          drawNeonPulse(ctx, width, height, dataArray, moodTheme, phase, energy);
          break;
        case 'Liquid Waves':
          drawLiquidWaves(ctx, width, height, dataArray, moodTheme, phase);
          break;
        case 'Dreamscape':
          drawDreamscape(ctx, width, height, dataArray, moodTheme, phase, mid);
          break;
        case 'Minimal Spectrum':
          drawMinimalSpectrum(ctx, width, height, dataArray, moodTheme);
          break;
        case 'Cinematic Particles':
          drawCinematicParticles(ctx, width, height, dataArray, moodTheme, phase, treble);
          break;
        case 'Retro Synthwave':
          drawRetroSynthwave(ctx, width, height, dataArray, moodTheme, phase, bass);
          break;
        default:
          drawAurora(ctx, width, height, dataArray, moodTheme, phase, energy);
      }

      animFrameRef.current = requestAnimationFrame(render);
    };

    render();

    return () => {
      window.removeEventListener('resize', resizeCanvas);
      if (animFrameRef.current) cancelAnimationFrame(animFrameRef.current);
    };
  }, [visualizerStyle, moodTheme, isPlaying]);

  // --- VISUALIZER DRAWING ENGINES ---
  const drawAurora = (ctx, w, h, data, theme, phase, energy) => {
    ctx.fillStyle = '#080811';
    ctx.fillRect(0, 0, w, h);

    const gradient = ctx.createLinearGradient(0, 0, w, h);
    gradient.addColorStop(0, theme.secondary);
    gradient.addColorStop(0.5, theme.primary);
    gradient.addColorStop(1, '#080811');

    ctx.save();
    ctx.globalCompositeOperation = 'screen';

    for (let i = 0; i < 3; i++) {
      ctx.beginPath();
      ctx.moveTo(0, h * 0.6);
      for (let x = 0; x <= w; x += 30) {
        const freqIdx = Math.floor((x / w) * data.length);
        const amp = (data[freqIdx] || 20) * (energy / 150);
        const y = h * 0.5 + Math.sin(phase + x * 0.005 + i * 1.5) * 80 + Math.cos(phase * 0.5 + x * 0.01) * amp;
        ctx.lineTo(x, y);
      }
      ctx.lineTo(w, h);
      ctx.lineTo(0, h);
      ctx.fillStyle = gradient;
      ctx.globalAlpha = 0.3 + i * 0.15;
      ctx.fill();
    }
    ctx.restore();
  };

  const drawGalaxy = (ctx, w, h, data, theme, phase, bass) => {
    ctx.fillStyle = 'rgba(8, 8, 16, 0.3)';
    ctx.fillRect(0, 0, w, h);
    const cx = w / 2;
    const cy = h / 2;
    const scale = 1 + (bass / 255) * 0.3;

    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(phase * 0.2);

    for (let i = 0; i < 120; i++) {
      const angle = i * 0.2;
      const dist = (i * 3 + Math.sin(phase + i) * 10) * scale;
      const x = Math.cos(angle) * dist;
      const y = Math.sin(angle) * dist;
      const size = 1.5 + (data[i % data.length] / 255) * 4;

      ctx.beginPath();
      ctx.arc(x, y, size, 0, Math.PI * 2);
      ctx.fillStyle = i % 2 === 0 ? theme.primary : theme.secondary;
      ctx.shadowBlur = 10;
      ctx.shadowColor = theme.primary;
      ctx.fill();
    }
    ctx.restore();
  };

  const drawNeonPulse = (ctx, w, h, data, theme, phase, energy) => {
    ctx.fillStyle = '#080811';
    ctx.fillRect(0, 0, w, h);
    const cx = w / 2;
    const cy = h / 2;
    const radius = Math.min(w, h) * 0.2 + (energy / 255) * 40;

    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.strokeStyle = theme.primary;
    ctx.lineWidth = 4;
    ctx.shadowBlur = 25;
    ctx.shadowColor = theme.primary;
    ctx.stroke();

    // Equalizer spikes around circle
    const spikes = 32;
    for (let i = 0; i < spikes; i++) {
      const angle = (i / spikes) * Math.PI * 2 + phase * 0.5;
      const val = (data[i % data.length] / 255) * 60;
      const x1 = cx + Math.cos(angle) * radius;
      const y1 = cy + Math.sin(angle) * radius;
      const x2 = cx + Math.cos(angle) * (radius + val);
      const y2 = cy + Math.sin(angle) * (radius + val);

      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.strokeStyle = theme.secondary;
      ctx.lineWidth = 3;
      ctx.stroke();
    }
    ctx.restore();
  };

  const drawLiquidWaves = (ctx, w, h, data, theme, phase) => {
    ctx.fillStyle = '#05050d';
    ctx.fillRect(0, 0, w, h);

    ctx.save();
    for (let wave = 0; wave < 4; wave++) {
      ctx.beginPath();
      ctx.moveTo(0, h);
      for (let x = 0; x <= w; x += 20) {
        const val = data[(x + wave * 50) % data.length] || 30;
        const y = h * 0.65 + Math.sin(x * 0.01 + phase + wave) * 40 + (val / 255) * 50;
        ctx.lineTo(x, y);
      }
      ctx.lineTo(w, h);
      ctx.fillStyle = wave % 2 === 0 ? theme.primary : theme.secondary;
      ctx.globalAlpha = 0.25;
      ctx.fill();
    }
    ctx.restore();
  };

  const drawDreamscape = (ctx, w, h, data, theme, phase, mid) => {
    ctx.fillStyle = '#0a0a14';
    ctx.fillRect(0, 0, w, h);

    for (let i = 0; i < 6; i++) {
      const x = (Math.sin(phase * 0.5 + i * 2) * 0.4 + 0.5) * w;
      const y = (Math.cos(phase * 0.3 + i * 1.5) * 0.3 + 0.5) * h;
      const r = 80 + (data[i * 4 % data.length] / 255) * 120;

      const radGrad = ctx.createRadialGradient(x, y, 10, x, y, r);
      radGrad.addColorStop(0, theme.primary);
      radGrad.addColorStop(1, 'transparent');

      ctx.save();
      ctx.fillStyle = radGrad;
      ctx.globalAlpha = 0.35;
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  };

  const drawMinimalSpectrum = (ctx, w, h, data, theme) => {
    ctx.fillStyle = '#080811';
    ctx.fillRect(0, 0, w, h);

    const barWidth = (w / data.length) * 1.2;
    const startX = (w - barWidth * data.length) / 2;

    for (let i = 0; i < data.length; i++) {
      const barHeight = (data[i] / 255) * (h * 0.5);
      const x = startX + i * (barWidth + 4);
      const y = h / 2 - barHeight / 2;

      const grad = ctx.createLinearGradient(x, y, x, y + barHeight);
      grad.addColorStop(0, theme.primary);
      grad.addColorStop(1, theme.secondary);

      ctx.fillStyle = grad;
      ctx.fillRect(x, y, barWidth, barHeight);

      // Reflection
      ctx.fillStyle = theme.primary;
      ctx.globalAlpha = 0.15;
      ctx.fillRect(x, y + barHeight + 4, barWidth, barHeight * 0.4);
      ctx.globalAlpha = 1.0;
    }
  };

  const drawCinematicParticles = (ctx, w, h, data, theme, phase, treble) => {
    ctx.fillStyle = 'rgba(5, 5, 12, 0.4)';
    ctx.fillRect(0, 0, w, h);

    const particleCount = 60;
    for (let i = 0; i < particleCount; i++) {
      const x = (Math.sin(i * 99 + phase * 0.2) * 0.5 + 0.5) * w;
      const y = (Math.cos(i * 33 + phase * 0.3) * 0.5 + 0.5) * h;
      const size = 2 + (treble / 255) * 6 + Math.sin(phase + i) * 2;

      ctx.beginPath();
      ctx.arc(x, y, Math.max(1, size), 0, Math.PI * 2);
      ctx.fillStyle = theme.primary;
      ctx.shadowBlur = 15;
      ctx.shadowColor = theme.primary;
      ctx.fill();
    }
  };

  const drawRetroSynthwave = (ctx, w, h, data, theme, phase, bass) => {
    ctx.fillStyle = '#0a0512';
    ctx.fillRect(0, 0, w, h);

    // Sun
    const sunX = w / 2;
    const sunY = h * 0.45;
    const sunR = 70 + (bass / 255) * 20;

    const sunGrad = ctx.createLinearGradient(sunX, sunY - sunR, sunX, sunY + sunR);
    sunGrad.addColorStop(0, '#f59e0b');
    sunGrad.addColorStop(1, '#ec4899');

    ctx.beginPath();
    ctx.arc(sunX, sunY, sunR, 0, Math.PI * 2);
    ctx.fillStyle = sunGrad;
    ctx.shadowBlur = 30;
    ctx.shadowColor = '#ec4899';
    ctx.fill();
    ctx.shadowBlur = 0;

    // Horizon line
    const horizonY = h * 0.55;
    ctx.strokeStyle = theme.primary;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, horizonY);
    ctx.lineTo(w, horizonY);
    ctx.stroke();

    // Perspective Grid Lines
    const gridCols = 16;
    for (let i = -gridCols; i <= gridCols; i++) {
      ctx.beginPath();
      ctx.moveTo(w / 2 + i * 20, horizonY);
      ctx.lineTo(w / 2 + i * 120, h);
      ctx.strokeStyle = 'rgba(236, 72, 153, 0.3)';
      ctx.stroke();
    }
  };

  // --- CONTROLLER HANDLERS ---
  const handlePlayTrack = (track) => {
    if (currentTrack?.id === track.id) {
      setIsPlaying(!isPlaying);
    } else {
      setCurrentTrack(track);
      setIsPlaying(true);
      // Add to history
      setHistory((prev) => [track, ...prev.filter((t) => t.id !== track.id)]);
    }
  };

  const handleNextTrack = () => {
    if (queue.length === 0) return;
    const currentIndex = queue.findIndex((t) => t.id === currentTrack?.id);
    let nextIndex = 0;
    if (isShuffle) {
